# Copy to .env and replace every CHANGE_ME. Never commit .env.

# ---- Django
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_to_a_random_value_of_at_least_50_characters_xxxxxxxxxxxx
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Obscure the admin path in production (keep the trailing slash)
DJANGO_ADMIN_URL=admin/
# Local Docker runs over plain http → cookies cannot be Secure. Set both to true behind HTTPS.
DJANGO_SECURE_COOKIES=false
DJANGO_HSTS_SECONDS=0
DJANGO_SSL_REDIRECT=false
LOG_LEVEL=INFO

# ---- Database
POSTGRES_DB=xcore
POSTGRES_USER=xcore
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ---- X-Core
# Load the prototype library on start-up (idempotent: skipped when data exists)
XCORE_LOAD_DEMO=true
# Demo sign-ins (xcore.admin, process.editor, process.approver, xcore.viewer) are created ONLY if set.
# Min 12 chars, not common, not numeric. Leave empty in production and use `createsuperuser`.
XCORE_DEMO_PASSWORD=
XCORE_HTTP_PORT=8080
