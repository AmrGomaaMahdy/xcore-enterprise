# syntax=docker/dockerfile:1.7
# Single-service image for Render (or any PaaS): Django API + the built React app on one origin.
# Build context: repository root.

# ---------- 1. build the React app
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# ---------- 2. build Python wheels (no compilers in the final image)
FROM python:3.12-slim AS wheels
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY backend/requirements.txt .
RUN pip wheel --wheel-dir /wheels -r requirements.txt

# ---------- 3. runtime
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_SETTINGS_MODULE=config.settings.prod \
    XCORE_SPA_DIR=/app/spa \
    PORT=10000
RUN groupadd --system --gid 10001 xcore \
 && useradd --system --uid 10001 --gid xcore --home-dir /app --shell /usr/sbin/nologin xcore
WORKDIR /app
COPY --from=wheels /wheels /wheels
RUN pip install --no-index --find-links=/wheels /wheels/* && rm -rf /wheels
COPY --chown=xcore:xcore backend/ ./
COPY --from=web --chown=xcore:xcore /web/dist ./spa
RUN chmod +x docker/entrypoint.sh \
 && DJANGO_SECRET_KEY=build-only-not-secret-build-only-not-secret-xx DB_ENGINE=sqlite \
    python manage.py collectstatic --noinput -v0 \
 && chown -R xcore:xcore /app/staticfiles
USER xcore
EXPOSE 10000
ENTRYPOINT ["docker/entrypoint.sh"]
# Render injects PORT; WEB_CONCURRENCY tunes workers to the instance size
CMD ["sh", "-c", "exec gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-10000} --workers ${WEB_CONCURRENCY:-2} --threads 2 --timeout 60 --access-logfile - --forwarded-allow-ips '*'"]
